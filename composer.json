{
  "name": "tallieutallieu/dry-mollie",
  "description": "Mollie payment gateway for dry-ecommerce",
  "type": "library",
  "license": "proprietary",
  "minimum-stability": "beta",
  "require": {
    "php": ">=8.4",
    "mollie/mollie-api-php": "^3.13",
    "tallieutallieu/dry-ecommerce": "^3.12"
  },
  "require-dev": {
    "pestphp/pest": "^3.8",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Tnt\\Mollie\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=512M"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/TallieuTallieu/dry-ecommerce",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "git@bitbucket.org:tallieu/dry3.git"
    }
  ]
}
